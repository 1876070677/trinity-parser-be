# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=trinity
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# API Gateway
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=your_jwt_secret_here

# Logging
# logging-service의 로그가 쌓이는 호스트 경로. 반드시 Git 워크스페이스(리포지토리) 바깥의
# 절대경로여야 checkout/clean 시 삭제 충돌이 발생하지 않음. (미설정 시 /var/trinity/logs 사용)
LOG_DIR=/var/trinity/logs

# Kafka
# broker1~3의 데이터가 쌓이는 호스트 경로. 브로커 프로세스가 만드는 세그먼트/체크포인트 파일은
# 소유권이 Jenkins 계정과 달라 워크스페이스 내부에 두면 checkout/clean이 삭제하지 못하고 실패함.
# 반드시 Git 워크스페이스(리포지토리) 바깥의 절대경로 사용. (미설정 시 /var/trinity/kafka 사용)
KAFKA_DATA_DIR=/var/trinity/kafka
